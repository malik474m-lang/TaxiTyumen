<Window x:Class="TaxiOperator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Такси Тюмень  Пульт оператора"
        Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Loaded="OnWindowLoaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВАЯ ПАНЕЛЬ: Создание заказа ===== -->
        <Border Grid.Column="0" Background="#252536"
                BorderBrush="#333" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Margin="15">
                    <!-- ===== СОФТФОН (SIP) ===== -->
                    <Border x:Name="SipPanel" Background="#2D2D3F" CornerRadius="10"
                            Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Телефония" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <Button Content="Настройки" HorizontalAlignment="Right"
                                        Click="OnSipSettingsClick" Background="Transparent"
                                        Foreground="#4FC3F7" BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            </Grid>
                            <TextBlock x:Name="SipStatusText" Text="SIP не настроен"
                                       Foreground="LightGray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SipCallerText" Text="" Foreground="{DynamicResource BrandBrush}"
                                       FontSize="17" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="SipTimerText" Text="" Foreground="#4CAF50"
                                       FontSize="12" Margin="0,2,0,0"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SipAnswerBtn" Grid.Column="0" Content="Ответить"
                                        Click="OnSipAnswerClick" Background="#4CAF50" Foreground="White"
                                        BorderThickness="0" Padding="8,7" FontWeight="Bold"
                                        Cursor="Hand" IsEnabled="False"/>
                                <Button x:Name="SipHangupBtn" Grid.Column="2" Content="Сброс"
                                        Click="OnSipHangupClick" Background="#F44336" Foreground="White"
                                        BorderThickness="0" Padding="8,7" FontWeight="Bold"
                                        Cursor="Hand" IsEnabled="False"/>
                                <ToggleButton x:Name="SipMuteBtn" Grid.Column="4" Content="Микр."
                                              Click="OnSipMuteClick" Background="#333" Foreground="White"
                                              BorderThickness="0" Padding="8,7" Cursor="Hand" IsEnabled="False"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SipDialBox" Grid.Column="0" Background="#1E1E2E"
                                         Foreground="White" BorderBrush="#555" Padding="8,6"
                                         FontSize="13" ToolTip="Номер для исходящего вызова"/>
                                <Button Grid.Column="2" Content="Позвонить" Click="OnSipCallClick"
                                        Background="#2196F3" Foreground="White" BorderThickness="0"
                                        Padding="10,6" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text=" Новый заказ"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource BrandBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="Телефон клиента:" Foreground="LightGray" Margin="0,0,0,3"/>
                    <TextBox x:Name="ClientPhoneBox" Text="+7"
                             Padding="8,6" Background="#2D2D3F"
                             Foreground="White" BorderBrush="#555"
                             Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Text="Имя клиента:" Foreground="LightGray" Margin="0,0,0,3"/>
                    <TextBox x:Name="ClientNameBox"
                             Padding="8,6" Background="#2D2D3F"
                             Foreground="White" BorderBrush="#555"
                             Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Text=" Откуда:" Foreground="LightGray" Margin="0,0,0,3"/>
                    <TextBox x:Name="PickupAddressBox"
                             Padding="8,6" Background="#2D2D3F"
                             Foreground="White" BorderBrush="#555"
                             Margin="0,0,0,2" FontSize="13"
                             TextChanged="OnPickupChanged"/>
                    <ListBox x:Name="PickupSuggestionsList"
                             MaxHeight="120" Visibility="Collapsed"
                             Background="#2D2D3F" Foreground="White"
                             BorderBrush="#555" Margin="0,0,0,8"
                             SelectionChanged="OnPickupSuggestionSelected"/>

                    

                    

                    <TextBlock Text=" Подъезд:" Foreground="LightGray" Margin="0,0,0,3"/>
                    <TextBox x:Name="EntranceBox"
                             Padding="8,6" Background="#2D2D3F"
                             Foreground="White" BorderBrush="#555"
                             Margin="0,0,0,10" FontSize="13"
                             Width="80" HorizontalAlignment="Left"/>
                    <TextBlock Text=" Куда (необязательно):" Foreground="LightGray" Margin="0,0,0,3"/>
                    <TextBox x:Name="DestinationBox"
                             Padding="8,6" Background="#2D2D3F"
                             Foreground="White" BorderBrush="#555"
                             Margin="0,0,0,2" FontSize="13"
                             TextChanged="OnDestChanged"/>
                    <ListBox x:Name="DestSuggestionsList"
                             MaxHeight="120" Visibility="Collapsed"
                             Background="#2D2D3F" Foreground="White"
                             BorderBrush="#555" Margin="0,0,0,8"
                             SelectionChanged="OnDestSuggestionSelected"/>

                    <TextBlock Text="Тариф:" Foreground="LightGray" Margin="0,0,0,3"/>
                    <ComboBox x:Name="TariffCombo" SelectedIndex="0"
                              Padding="8,6" Margin="0,0,0,10"
                              FontSize="13">
                        <ComboBoxItem Content=" Эконом" Tag="Economy"/>
                        <ComboBoxItem Content=" Комфорт" Tag="Comfort"/>
                        <ComboBoxItem Content=" Бизнес" Tag="Business"/>
                        <ComboBoxItem Content=" Минивэн" Tag="Minivan"/>
                    </ComboBox>

                    <TextBlock Text="Пассажиров:" Foreground="LightGray" Margin="0,0,0,3"/>
                    <ComboBox x:Name="PassengersCombo" SelectedIndex="0"
                              Padding="8,6" Margin="0,0,0,10" FontSize="13">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                    </ComboBox>

                    <TextBlock Text="Комментарий:" Foreground="LightGray" Margin="0,0,0,3"/>
                    <TextBox x:Name="CommentBox"
                             Padding="8,6" Background="#2D2D3F"
                             Foreground="White" BorderBrush="#555"
                             Margin="0,0,0,10" FontSize="13"
                             Height="55" TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <!-- Стоимость -->
                    <Border Background="#2D2D3F" CornerRadius="8" Padding="12" Margin="0,5,0,10">
                        <StackPanel>
                            <TextBlock Text="Примерная стоимость:" Foreground="LightGray" FontSize="11"/>
                            <TextBlock x:Name="PriceText" Text="" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrandBrush}"/>
                            <TextBlock x:Name="DistanceText" Text="" Foreground="LightGray" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Создать заказ -->
                    <Button x:Name="CreateOrderBtn"
                            Content="  Создать заказ"
                            FontSize="15" FontWeight="Bold"
                            Height="46" Background="#4CAF50"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,0,8"
                            Click="OnCreateOrderClick"/>

                    <Button Content="  Очистить"
                            FontSize="13" Height="36"
                            Background="#555" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="OnClearFormClick"/>

                    <Border Background="#2D2D3F" CornerRadius="6" Padding="10" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="BrandNameText" Text="Такси"
                                       Foreground="{DynamicResource BrandBrush}"
                                       FontSize="14" FontWeight="Bold"/>
                            <TextBlock x:Name="BrandAppText" Text="Пульт оператора"
                                       Foreground="LightGray" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock Text="Оператор:" Foreground="LightGray" FontSize="11"/>
                            <TextBlock x:Name="OperatorNameText" Foreground="White" FontSize="13"/>
                            <TextBlock x:Name="BrandSupportText" Text=""
                                       Foreground="#7dd3fc" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== ЦЕНТР: Список заказов ===== -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Статистика -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                <Border Background="#2D2D3F" CornerRadius="8" Margin="3" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Активных" Foreground="LightGray" HorizontalAlignment="Center" FontSize="11"/>
                        <TextBlock x:Name="ActiveCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D2D3F" CornerRadius="8" Margin="3" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Ожидают" Foreground="LightGray" HorizontalAlignment="Center" FontSize="11"/>
                        <TextBlock x:Name="WaitingCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D2D3F" CornerRadius="8" Margin="3" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Водителей онлайн" Foreground="LightGray" HorizontalAlignment="Center" FontSize="11"/>
                        <TextBlock x:Name="DriversCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D2D3F" CornerRadius="8" Margin="3" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Обновлено" Foreground="LightGray" HorizontalAlignment="Center" FontSize="11"/>
                        <TextBlock x:Name="LastUpdateText" Text="" FontSize="13" Foreground="LightGray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Button Grid.Row="1" Content=" Обновить список"
                    HorizontalAlignment="Left" Padding="12,6"
                    Background="#333" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,8" Click="OnRefreshClick"/>

            <DataGrid Grid.Row="2" x:Name="OrdersGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#1E1E2E" Foreground="White"
                      RowBackground="#252536" AlternatingRowBackground="#2A2A3F"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333"
                      HeadersVisibility="Column" BorderBrush="#444" FontSize="12"
                      SelectionChanged="OnOrderSelected">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#333"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="130"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding ClientDisplay}" Width="140"/>
                    <DataGridTextColumn Header="Откуда" Binding="{Binding PickupAddress}" Width="180"/>
                    <DataGridTextColumn Header="Куда" Binding="{Binding DestinationAddress}" Width="180"/>
                    <DataGridTextColumn Header="Водитель" Binding="{Binding DriverDisplay}" Width="130"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding PriceDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding TimeDisplay}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ===== ПРАВАЯ ПАНЕЛЬ: Детали заказа ===== -->
        <Border Grid.Column="2" Background="#252536" BorderBrush="#333" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel x:Name="DetailsPanel" Margin="15">
                    <TextBlock Text="Детали заказа" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                    <TextBlock x:Name="DetailNumber" Foreground="{DynamicResource BrandBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Статус:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailStatus" Foreground="White" FontSize="13" Margin="0,2,0,10"/>

                    <TextBlock Text="Клиент:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailClient" Foreground="White" FontSize="13" Margin="0,2,0,10"/>

                    <TextBlock Text="Телефон:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailPhone" Foreground="#4FC3F7" FontSize="13" Margin="0,2,0,10" Cursor="Hand"/>

                    <TextBlock Text="Откуда:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailPickup" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <TextBlock Text="Куда:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailDest" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <TextBlock Text="Водитель:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailDriver" Foreground="White" FontSize="13" Margin="0,2,0,10"/>

                    <TextBlock Text="Автомобиль:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailCar" Foreground="White" FontSize="13" Margin="0,2,0,10"/>

                    <TextBlock Text="Тариф:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailTariff" Foreground="White" FontSize="13" Margin="0,2,0,10"/>

                    <TextBlock Text="Стоимость:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailPrice" Foreground="{DynamicResource BrandBrush}" FontSize="22" FontWeight="Bold" Margin="0,2,0,10"/>

                    <TextBlock Text="Расстояние / Время:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailDistTime" Foreground="White" FontSize="13" Margin="0,2,0,10"/>

                    <TextBlock Text="Комментарий:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailComment" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,15"/>

                    <Separator Background="#444" Margin="0,0,0,15"/>

                    <!-- БАЛАНС И ПОПОЛНЕНИЕ -->
                    <TextBlock Text="Баланс водителя:" Foreground="LightGray" FontSize="11"/>
                    <TextBlock x:Name="DetailDriverBalance" Foreground="#4CAF50" FontSize="18" FontWeight="Bold" Margin="0,2,0,8"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TopUpAmountBox" Grid.Column="0" Text="300"
                                 Padding="8,6" Background="#2D2D3F" Foreground="White"
                                 BorderBrush="#555" FontSize="13" Margin="0,0,8,0"/>

                        <Button x:Name="TopUpBalanceBtn" Grid.Column="1" Content=" Пополнить"
                                Background="#4CAF50" Foreground="White" BorderThickness="0"
                                FontSize="12" Click="OnTopUpBalanceClick"/>
                    </Grid>

                    <TextBlock Text="История баланса:" Foreground="LightGray" FontSize="11"/>
                    <ListBox x:Name="BalanceHistoryList"
                             Height="120" Background="#2D2D3F"
                             Foreground="White" BorderBrush="#555"
                             Margin="0,4,0,15">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="White" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Background="#444" Margin="0,0,0,15"/>

                    <!-- КНОПКИ ДЕЙСТВИЙ -->
                    <TextBlock Text="Действия:" Foreground="LightGray" FontSize="11" Margin="0,0,0,6"/>

                    <Button x:Name="CancelOrderBtn"
                            Content=" Отменить заказ"
                            Background="#F44336"
                            Foreground="White"
                            BorderThickness="0"
                            Height="40"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Margin="0,0,0,8"
                            Click="OnCancelOrderClick"
                            IsEnabled="False"/>

                    <Button Content=" Назначить свободного водителя"
                            Click="OnForceAssignAvailableClick"
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Height="40"
                            FontSize="13"
                            FontWeight="Bold"
                            Margin="0,0,0,10"
                            Cursor="Hand"/>

                    <TextBlock Text="Штраф за отказ:" Foreground="LightGray" FontSize="11" Margin="0,0,0,4"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="PenaltyPresetCombo"
                                  Grid.Column="0"
                                  SelectedIndex="0"
                                  Margin="0,0,6,0"
                                  SelectionChanged="OnPenaltyPresetChanged">
                            <ComboBoxItem Content="50 ₽"/>
                            <ComboBoxItem Content="100 ₽"/>
                            <ComboBoxItem Content="200 ₽"/>
                            <ComboBoxItem Content="Своя"/>
                        </ComboBox>

                        <TextBox x:Name="PenaltyAmountBox"
                                 Grid.Column="1"
                                 Text="50"
                                 Padding="8,6"
                                 Background="#2D2D3F"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 FontSize="12"
                                 Margin="0,0,6,0"/>

                        <Button Grid.Column="2"
                                Content=" Штраф"
                                Click="OnChargePenaltyPresetClick"
                                Background="#FF9800"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>