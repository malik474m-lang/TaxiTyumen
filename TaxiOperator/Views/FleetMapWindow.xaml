<Window x:Class="TaxiOperator.Views.FleetMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Карта автопарка"
        Height="760" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Карта автопарка" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Загрузка карты…" Foreground="LightGray"
                       Margin="16,0,0,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="FollowCheck" Content="Следить за выбранной машиной"
                      Foreground="LightGray" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <Button Content="Обновить" Click="OnRefreshClick"
                    Background="#333" Foreground="White" BorderThickness="0"
                    Padding="12,6" Margin="20,0,0,0" Cursor="Hand"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="#0F0F13" CornerRadius="8">
            <Grid>
                <wv2:WebView2 x:Name="MapView"/>
                <TextBlock x:Name="MapFallbackText"
                           Text="Карта недоступна. Установите Microsoft Edge WebView2 Runtime."
                           Foreground="#fca5a5" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Margin="30" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#252536"
                CornerRadius="8" Margin="10,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Водители в сети"
                           Foreground="White" FontWeight="Bold" FontSize="14"
                           Margin="12,12,12,8"/>
                <ListBox x:Name="DriversList" Background="Transparent" BorderThickness="0"
                         Foreground="White" Margin="6,0,6,10"
                         SelectionChanged="OnDriverSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="#2D2D3F"/>
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding CarLine}" Foreground="LightGray" FontSize="12"/>
                                <TextBlock Text="{Binding StatusLine}" Foreground="#7dd3fc" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
