<Window x:Class="TaxiOperator.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Такси Тюмень  Вход"
        Height="420" Width="440"
        MinHeight="420" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        KeyDown="OnKeyDown">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" Margin="50,30">

            <!-- Логотип -->
            <TextBlock Text="" FontSize="48"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <TextBlock x:Name="BrandTitleText" Text="Такси"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource BrandBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="BrandSubtitleText" Text="Пульт оператора"
                       FontSize="13" Foreground="LightGray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <!-- Телефон -->
            <TextBlock Text="Телефон:"
                       Foreground="White"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="PhoneBox"
                     Text="+79001234568"
                     Padding="10,8" FontSize="14"
                     Background="#2D2D3F"
                     Foreground="White"
                     BorderBrush="#666"
                     BorderThickness="1"
                     CaretBrush="White"
                     Margin="0,0,0,12"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль:"
                       Foreground="White"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         Padding="10,8" FontSize="14"
                         Background="#2D2D3F"
                         Foreground="White"
                         BorderBrush="#666"
                         BorderThickness="1"
                         Margin="0,0,0,8"/>

            <!-- Ошибка -->
            <TextBlock x:Name="ErrorText"
                       Foreground="#FF6B6B"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="Collapsed"/>

            <!-- Кнопка -->
            <Button x:Name="LoginButton"
                    Content="Войти"
                    FontSize="16"
                    FontWeight="Bold"
                    Height="46"
                    Margin="0,10,0,0"
                    Background="#FFD700"
                    Foreground="#1E1E2E"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="OnLoginClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFC107"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#FF8F00"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Подсказка -->
            <TextBlock Text="Тестовый вход: +79001234568 / Operator123!"
                       Foreground="#555" FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Window>
