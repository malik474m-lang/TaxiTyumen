<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaxiClient.Views.MainClientPage"
             Title="Такси Тюмень"
             BackgroundColor="#1E1E2E">

    <ScrollView>
        <StackLayout Spacing="0">

            <!-- КАРТА -->
            <WebView x:Name="MapWebView" HeightRequest="300"/>

            <!-- ПАНЕЛЬ ЗАКАЗА -->
            <StackLayout x:Name="OrderPanel"
                         Padding="18,16"
                         Spacing="10"
                         BackgroundColor="#252536">

                <Label Text=" Куда едем?"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"/>

                <!-- Откуда -->
                <Label Text="Откуда:"
                       TextColor="LightGray"
                       FontSize="12"
                       Margin="0,0,0,-6"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            BackgroundColor="#2D2D3F"
                            Stroke="#555"
                            Padding="6,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="PickupEntry"
                               Placeholder="Адрес подачи"
                               PlaceholderColor="Gray"
                               TextColor="White"
                               FontSize="15"
                               TextChanged="OnPickupTextChanged"/>
                    </Border>
                    <!-- Определить адрес подачи по GPS телефона -->
                    <Button Grid.Column="1"
                            x:Name="LocateBtn"
                            Text="📍"
                            FontSize="18"
                            BackgroundColor="#2D2D3F"
                            TextColor="White"
                            CornerRadius="10"
                            WidthRequest="48"
                            HeightRequest="44"
                            Padding="0"
                            Clicked="OnLocateClicked"/>
                </Grid>

                <Label x:Name="LocateHintLabel"
                       Text=""
                       FontSize="11"
                       TextColor="#8FBF9F"
                       IsVisible="False"/>

                <StackLayout x:Name="PickupSuggestions"
                             Spacing="2"
                             BackgroundColor="#2D2D3F"
                             IsVisible="False"/>

                <!-- Подъезд -->
                <HorizontalStackLayout Spacing="8">
                    <Label Text=" Подъезд:"
                           TextColor="LightGray"
                           FontSize="13"
                           VerticalOptions="Center"/>
                    <Border BackgroundColor="#2D2D3F"
                            Stroke="#555"
                            Padding="6,2"
                            WidthRequest="70">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EntranceEntry"
                               Placeholder="№"
                               PlaceholderColor="Gray"
                               TextColor="White"
                               FontSize="15"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="Center"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Куда -->
                <Label Text="Куда:"
                       TextColor="LightGray"
                       FontSize="12"
                       Margin="0,0,0,-6"/>
                <Border BackgroundColor="#2D2D3F"
                        Stroke="#555"
                        Padding="6,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry x:Name="DestEntry"
                           Placeholder="Адрес назначения"
                           PlaceholderColor="Gray"
                           TextColor="White"
                           FontSize="15"
                           TextChanged="OnDestTextChanged"/>
                </Border>

                <StackLayout x:Name="DestSuggestions"
                             Spacing="2"
                             BackgroundColor="#2D2D3F"
                             IsVisible="False"/>

                <!-- Остановки -->
                <StackLayout x:Name="StopsPanel" Spacing="6"/>

                <Button x:Name="AddStopBtn"
                        Text="＋ Остановка"
                        BackgroundColor="Transparent"
                        TextColor="#4FC3F7"
                        FontSize="13"
                        HorizontalOptions="Start"
                        Padding="0"
                        HeightRequest="30"
                        Clicked="OnAddStopClicked"/>

                <BoxView HeightRequest="1" Color="#444"/>

                <!-- Опции: справочник и цены приходят с сервера (админка → «Опции заказа») -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <!-- Опции заказа — колонкой: длинные названия и цены не обрезаются -->
                    <VerticalStackLayout x:Name="OptionsContainer" Spacing="2"/>
                </ScrollView>

                <HorizontalStackLayout Spacing="12">
                    <Label Text=""
                           FontSize="16"
                           VerticalOptions="Center"/>
                    <Border BackgroundColor="#2D2D3F"
                            Stroke="#555"
                            Padding="8,2"
                            WidthRequest="50">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Entry x:Name="PassengerEntry"
                               Text="1"
                               TextColor="White"
                               FontSize="14"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="Center"/>
                    </Border>

                    <Border BackgroundColor="#2D2D3F"
                            Stroke="#555"
                            Padding="4,2"
                            HorizontalOptions="FillAndExpand">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Entry x:Name="CommentEntry"
                               Placeholder=" Комментарий"
                               PlaceholderColor="Gray"
                               TextColor="White"
                               FontSize="12"/>
                    </Border>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="#444"/>

                <!-- Тарифы -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="TariffPanel" Spacing="8"/>
                </ScrollView>

                <!-- Стоимость -->
                <Border BackgroundColor="#1A3A1A"
                        Stroke="#4CAF50"
                        Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <StackLayout>
                        <Label Text="Стоимость:"
                               TextColor="LightGray"
                               FontSize="12"/>
                        <HorizontalStackLayout Spacing="10">
                            <Label x:Name="PriceLabel"
                                   Text=""
                                   TextColor="#FFD700"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <Label x:Name="DistLabel"
                                   Text=""
                                   TextColor="Gray"
                                   FontSize="13"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </StackLayout>
                </Border>

                <!-- Способ оплаты -->
                <Label Text="Способ оплаты:" TextColor="LightGray" FontSize="12"/>
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="PayCashBtn"
                            Text=" Наличные"
                            BackgroundColor="#FFD700"
                            TextColor="#1E1E2E"
                            CornerRadius="16"
                            HeightRequest="34"
                            FontSize="12"
                            Clicked="OnPayCash"/>
                    <Button x:Name="PayCardBtn"
                            Text=" Перевод"
                            BackgroundColor="#333"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="34"
                            FontSize="12"
                            Clicked="OnPayCard"/>
                </HorizontalStackLayout>

                <Button Text=" Рассчитать стоимость"
                        BackgroundColor="#333"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="42"
                        FontSize="14"
                        Clicked="OnCalcPriceClicked"/>

                <Button x:Name="OrderBtn"
                        Text="  Заказать такси"
                        FontSize="20"
                        FontAttributes="Bold"
                        BackgroundColor="#FFD700"
                        TextColor="#1E1E2E"
                        HeightRequest="58"
                        CornerRadius="14"
                        Clicked="OnOrderClicked"/>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text=" Мои поездки"
                            BackgroundColor="#333"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="42"
                            FontSize="14"
                            Clicked="OnHistoryClicked"/>
                    <Button Grid.Column="1"
                            Text=" Выйти"
                            BackgroundColor="#2D2D3F"
                            TextColor="#EF5350"
                            CornerRadius="10"
                            HeightRequest="42"
                            Padding="16,0"
                            FontSize="14"
                            Clicked="OnLogoutClicked"/>
                </Grid>
            </StackLayout>

            <!-- БАННЕР ЧАТА -->
            <Border x:Name="ChatBanner"
                    IsVisible="False"
                    BackgroundColor="#1A2A4A"
                    Stroke="#2196F3"
                    StrokeThickness="2"
                    Padding="12,10"
                    Margin="10,10,10,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChatBannerTapped"/>
                </Border.GestureRecognizers>
                <StackLayout Spacing="4">
                    <Label Text="Для продолжения диалога нажмите на сообщение"
                           TextColor="#4FC3F7"
                           FontSize="11"/>
                    <Label x:Name="ChatBannerText"
                           Text=""
                           TextColor="White"
                           FontSize="15"
                           FontAttributes="Bold"/>
                    <Label x:Name="ChatBannerSender"
                           Text=""
                           TextColor="Gray"
                           FontSize="12"/>
                </StackLayout>
            </Border>

            <!-- АКТИВНЫЙ ЗАКАЗ -->
            <StackLayout x:Name="ActivePanel"
                         IsVisible="False"
                         Padding="18,20"
                         Spacing="10"
                         BackgroundColor="#252536">

                <Label x:Name="ActiveStatusLabel"
                       Text=""
                       TextColor="#4CAF50"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Label x:Name="ActiveOrderNum"
                       TextColor="#FFD700"
                       FontSize="14"
                       HorizontalOptions="Center"/>

                <!-- Через сколько подъедет водитель: считается по дорогам
                     от его текущего положения и обновляется каждые 15 секунд -->
                <Border x:Name="ActiveEtaPanel" IsVisible="False"
                        BackgroundColor="#12351E" Stroke="#4CAF50"
                        StrokeThickness="1" Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <StackLayout Spacing="2">
                        <Label x:Name="ActiveEtaLabel"
                               Text="Рассчитываем время подачи…"
                               TextColor="#4ADE80"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label x:Name="ActiveEtaHintLabel"
                               Text="Машина на карте отмечена жёлтой стрелкой"
                               TextColor="#8FBF9F"
                               FontSize="11"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <BoxView HeightRequest="1" Color="#444"/>

                <Border BackgroundColor="#2D2D3F" Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <StackLayout Spacing="4">
                        <Label Text="Водитель:"
                               TextColor="LightGray"
                               FontSize="12"/>
                        <Label x:Name="ActiveDriverLabel"
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold"/>
                        <Label x:Name="ActiveCarLabel"
                               TextColor="LightGray"
                               FontSize="14"/>
                        <!-- Госномер машины крупно: по нему пассажир узнаёт
                             свой автомобиль. Телефон водителя не показываем -->
                        <Label x:Name="ActivePlateLabel"
                               TextColor="#FFD700"
                               FontSize="20"
                               FontAttributes="Bold"
                               CharacterSpacing="2"/>
                    </StackLayout>
                </Border>

                <Border BackgroundColor="#2D2D3F" Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <StackLayout Spacing="4">
                        <Label x:Name="ActivePickupLabel"
                               TextColor="White"
                               FontSize="13"/>
                        <Label x:Name="ActiveDestLabel"
                               TextColor="LightGray"
                               FontSize="13"/>
                    </StackLayout>
                </Border>

                <Label x:Name="ActivePriceLabel"
                       TextColor="#FFD700"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Button Text=" Чат с водителем"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="44"
                        FontSize="15"
                        Margin="0,0,0,8"
                        Clicked="OnOpenChat"/>

                <Button x:Name="CancelBtn"
                        Text="  Отменить заказ"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="48"
                        FontSize="16"
                        Clicked="OnCancelClicked"/>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>