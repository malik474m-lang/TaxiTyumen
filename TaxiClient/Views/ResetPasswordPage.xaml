<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaxiClient.Views.ResetPasswordPage"
             Title="Восстановление пароля"
             BackgroundColor="#1E1E2E">
    <ScrollView>
        <VerticalStackLayout Padding="40" Spacing="0" VerticalOptions="Center">

            <Label Text="Восстановление пароля" FontSize="24" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center" Margin="0,0,0,6"/>
            <Label x:Name="HintLabel"
                   Text="Укажите телефон, к которому привязан аккаунт, — пришлём SMS-код"
                   FontSize="13" TextColor="Gray" HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <Label Text="Телефон:" TextColor="White" FontSize="14" Margin="0,0,0,4"/>
            <Border BackgroundColor="#2D2D3F" Stroke="#555" StrokeThickness="1" Padding="4,0" Margin="0,0,0,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <Entry x:Name="PhoneEntry" PlaceholderColor="Gray" TextColor="White"
                       FontSize="16" Keyboard="Telephone"/>
            </Border>

            <Button x:Name="SendCodeBtn" Text="Отправить код" FontSize="17" FontAttributes="Bold"
                    BackgroundColor="#FFD700" TextColor="#1E1E2E" HeightRequest="50"
                    CornerRadius="10" Margin="0,8,0,0" Clicked="OnSendCodeClicked"/>

            <!-- Шаг 2: появляется после отправки кода -->
            <VerticalStackLayout x:Name="CodePanel" IsVisible="False">

                <Label x:Name="DevCodeLabel" TextColor="#4ADE80" FontSize="13"
                       IsVisible="False" Margin="0,14,0,0" FontAttributes="Bold"/>

                <Label Text="Код из SMS:" TextColor="White" FontSize="14" Margin="0,14,0,4"/>
                <Border BackgroundColor="#2D2D3F" Stroke="#555" StrokeThickness="1" Padding="4,0" Margin="0,0,0,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Entry x:Name="CodeEntry" PlaceholderColor="Gray" TextColor="White"
                           FontSize="16" Keyboard="Numeric" MaxLength="6"/>
                </Border>

                <Label Text="Новый пароль:" TextColor="White" FontSize="14" Margin="0,0,0,4"/>
                <Border BackgroundColor="#2D2D3F" Stroke="#555" StrokeThickness="1" Padding="4,0" Margin="0,0,0,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Entry x:Name="NewPasswordEntry" PlaceholderColor="Gray" TextColor="White"
                           FontSize="16" IsPassword="True"/>
                </Border>

                <Label Text="Повторите пароль:" TextColor="White" FontSize="14" Margin="0,0,0,4"/>
                <Border BackgroundColor="#2D2D3F" Stroke="#555" StrokeThickness="1" Padding="4,0" Margin="0,0,0,8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Entry x:Name="RepeatPasswordEntry" PlaceholderColor="Gray" TextColor="White"
                           FontSize="16" IsPassword="True"/>
                </Border>

                <Button x:Name="ConfirmBtn" Text="Установить новый пароль" FontSize="17" FontAttributes="Bold"
                        BackgroundColor="#FFD700" TextColor="#1E1E2E" HeightRequest="50"
                        CornerRadius="10" Margin="0,10,0,0" Clicked="OnConfirmClicked"/>
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel" TextColor="#FF6B6B" FontSize="13"
                   IsVisible="False" Margin="0,12,0,0"/>
            <Label x:Name="InfoLabel" TextColor="#4ADE80" FontSize="13"
                   IsVisible="False" Margin="0,12,0,0"/>

            <ActivityIndicator x:Name="Loading" IsRunning="False" IsVisible="False"
                               Color="#FFD700" Margin="0,10,0,0" HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
