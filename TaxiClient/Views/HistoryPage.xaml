<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaxiClient.Views.HistoryPage"
             Title="Мои поездки" BackgroundColor="#1E1E2E">
    <ScrollView>
        <StackLayout x:Name="HistoryList" Padding="15" Spacing="10">
            <Label Text=" История поездок" TextColor="White"
                   FontSize="20" FontAttributes="Bold" Margin="0,0,0,10"/>
            <ActivityIndicator x:Name="Loading" IsRunning="True"
                               Color="#FFD700" HorizontalOptions="Center"/>
        </StackLayout>
    </ScrollView>
</ContentPage>