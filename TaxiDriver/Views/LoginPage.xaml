<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaxiDriver.Views.LoginPage"
             Title="Вход"
             BackgroundColor="#1E1E2E">

    <ScrollView>
        <VerticalStackLayout Padding="40" Spacing="0"
                             VerticalOptions="Center">

            <!-- Логотип -->
            <Label Text="" FontSize="64"
                   HorizontalOptions="Center"/>

            <Label Text="Такси Тюмень"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="#FFD700"
                   HorizontalOptions="Center"
                   Margin="0,0,0,4"/>

            <Label Text="Приложение водителя"
                   FontSize="14" TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,40"/>

            <!-- Телефон -->
            <Label Text="Номер телефона:" TextColor="White"
                   FontSize="14" Margin="0,0,0,6"/>
            <Border BackgroundColor="#2D2D3F"
                    Stroke="#555" StrokeThickness="1"
                    Padding="4,0" Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry x:Name="PhoneEntry"
                       Placeholder="+7 (999) 000-00-00"
                       PlaceholderColor="Gray"
                       TextColor="White"
                       FontSize="16"
                       Keyboard="Telephone"/>
            </Border>

            <!-- Пароль -->
            <Label Text="Пароль:" TextColor="White"
                   FontSize="14" Margin="0,0,0,6"/>
            <Border BackgroundColor="#2D2D3F"
                    Stroke="#555" StrokeThickness="1"
                    Padding="4,0" Margin="0,0,0,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry x:Name="PasswordEntry"
                       Placeholder="Пароль"
                       PlaceholderColor="Gray"
                       TextColor="White"
                       FontSize="16"
                       IsPassword="True"/>
            </Border>

            <!-- Ошибка -->
            <Label x:Name="ErrorLabel"
                   TextColor="#FF6B6B"
                   FontSize="13"
                   IsVisible="False"
                   Margin="0,0,0,8"/>

            <!-- Кнопка входа -->
            <Button x:Name="LoginBtn"
                    Text="Войти"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#FFD700"
                    TextColor="#1E1E2E"
                    HeightRequest="52"
                    CornerRadius="10"
                    Margin="0,15,0,0"
                    Clicked="OnLoginClicked"/>

            <!-- Индикатор загрузки -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#FFD700"
                               Margin="0,15,0,0"
                               HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
