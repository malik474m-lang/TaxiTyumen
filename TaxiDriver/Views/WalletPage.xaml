<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaxiDriver.Views.WalletPage"
             Title="Безнал и СБП" BackgroundColor="#1E1E2E">
  <ScrollView><VerticalStackLayout Padding="18" Spacing="12">
    <Label Text="Безналичный кошелёк" FontSize="24" FontAttributes="Bold" TextColor="White"/>
    <Label Text="Оплаченные картой поездки зачисляются сюда за вычетом комиссии сервиса"
           FontSize="12" TextColor="Gray"/>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
      <Border Grid.Column="0" BackgroundColor="#17351E" Stroke="#4CAF50" Padding="14">
        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
        <VerticalStackLayout><Label Text="Доступно" TextColor="#8FBF9F" FontSize="11"/><Label x:Name="AvailableLabel" Text="— ₽" TextColor="#4ADE80" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout>
      </Border>
      <Border Grid.Column="1" BackgroundColor="#2D2D3F" Stroke="#555" Padding="14">
        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
        <VerticalStackLayout><Label Text="В заявках" TextColor="Gray" FontSize="11"/><Label x:Name="PendingLabel" Text="— ₽" TextColor="#FACC15" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout>
      </Border>
    </Grid>
    <Label x:Name="TotalsLabel" Text="" TextColor="Gray" FontSize="12"/>

    <Border BackgroundColor="#252536" Stroke="#444" Padding="14">
      <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
      <VerticalStackLayout Spacing="8">
        <Label Text="Пополнить рабочий баланс" TextColor="White" FontAttributes="Bold"/>
        <Label Text="Через платёжную страницу Сбера. СБП появится только после включения банком."
               TextColor="Gray" FontSize="11"/>
        <Entry x:Name="TopupAmount" Placeholder="Сумма, ₽" Keyboard="Numeric" TextColor="White" PlaceholderColor="Gray"/>
        <Button Text="Пополнить через Сбер / СБП" BackgroundColor="#FACC15" TextColor="#0A0A0C" Clicked="OnTopup"/>
      </VerticalStackLayout>
    </Border>

    <Border BackgroundColor="#252536" Stroke="#444" Padding="14">
      <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
      <VerticalStackLayout Spacing="8">
        <Label Text="Заявка на вывод по СБП" TextColor="White" FontAttributes="Bold"/>
        <Label Text="Пока Сбер не одобрил автоматические выплаты B2C, администратор переводит вручную. После выплаты нужен чек самозанятого."
               TextColor="#FCA5A5" FontSize="11"/>
        <Entry x:Name="WithdrawAmount" Placeholder="Сумма от 100 ₽" Keyboard="Numeric" TextColor="White" PlaceholderColor="Gray"/>
        <Entry x:Name="SbpPhone" Placeholder="Телефон СБП" Keyboard="Telephone" TextColor="White" PlaceholderColor="Gray"/>
        <Entry x:Name="BankName" Placeholder="Банк получателя" TextColor="White" PlaceholderColor="Gray"/>
        <Entry x:Name="InnEntry" Placeholder="ИНН самозанятого (12 цифр)" Keyboard="Numeric" MaxLength="12" TextColor="White" PlaceholderColor="Gray"/>
        <Button Text="Создать заявку на вывод" BackgroundColor="#2196F3" TextColor="White" Clicked="OnWithdraw"/>
      </VerticalStackLayout>
    </Border>

    <Border BackgroundColor="#252536" Stroke="#444" Padding="14">
      <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
      <VerticalStackLayout Spacing="8">
        <Label Text="Чеки самозанятого" TextColor="White" FontAttributes="Bold"/>
        <Label x:Name="NpdStatusLabel" Text="Проверяем статус в ФНС…" FontSize="12" TextColor="Gray"/>
        <Label Text="Привяжите кабинет «Мой налог» — чек будет формироваться автоматически при каждой выплате, вручную ничего делать не нужно."
               FontSize="11" TextColor="#8FBF9F"/>
        <VerticalStackLayout x:Name="NpdLinkForm" Spacing="6">
          <Entry x:Name="NpdInn" Placeholder="ИНН (12 цифр)" Keyboard="Numeric" MaxLength="12"
                 TextColor="White" PlaceholderColor="Gray"/>
          <Entry x:Name="NpdPassword" Placeholder="Пароль от lknpd.nalog.ru" IsPassword="True"
                 TextColor="White" PlaceholderColor="Gray"/>
          <Label Text="Пароль не сохраняется: сервис получает только ключ доступа и может лишь выдавать чеки от вашего имени."
                 FontSize="10" TextColor="Gray"/>
          <Button x:Name="NpdLinkBtn" Text="Привязать «Мой налог»" BackgroundColor="#4CAF50"
                  TextColor="White" Clicked="OnLinkNpd"/>
        </VerticalStackLayout>
        <Button x:Name="NpdUnlinkBtn" Text="Отключить автоматические чеки" IsVisible="False"
                BackgroundColor="#3F3F46" TextColor="White" Clicked="OnUnlinkNpd"/>
        <VerticalStackLayout x:Name="NpdReceiptsList" Spacing="4"/>
      </VerticalStackLayout>
    </Border>

    <Label Text="Последние заявки" TextColor="White" FontAttributes="Bold"/>
    <VerticalStackLayout x:Name="WithdrawalsList" Spacing="6"/>
    <ActivityIndicator x:Name="Loading" IsRunning="True" Color="#FACC15"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
