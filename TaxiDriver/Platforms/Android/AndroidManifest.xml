<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application
		android:allowBackup="true"
		android:icon="@mipmap/appicon"
		android:roundIcon="@mipmap/appicon_round"
		android:label="Такси Тюмень — Водитель"
		android:usesCleartextTraffic="false"
		android:supportsRtl="true"></application>

	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Уведомления о заказах на Android 13+ (запрашивается в рантайме при старте) -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Держать процесс живым «на линии»; KeepScreenOn уже включается в коде -->
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<!-- Заготовка под фоновый GPS-трекинг (foreground service из дорожной карты) -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
	<!-- Сервис плавающей панели заказа (не требует геолокации) -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

	<!-- Геолокация водителя (приложение запрашивает в рантайме при выходе «на линию») -->
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

	<!-- Плавающая панель заказа поверх Яндекс Навигатора
	     (разрешение «Поверх других приложений» выдаётся водителем в системе) -->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

	<!-- Android 11+: видимость сторонних навигаторов для проверки «установлен ли»
	     и запуска маршрута. Без этой секции GetLaunchIntentForPackage всегда null. -->
	<queries>
		<package android:name="ru.yandex.yandexnavi" />
		<package android:name="ru.yandex.yandexmaps" />
		<package android:name="ru.dublgis.dgismobile" />
		<package android:name="com.google.android.apps.maps" />
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="yandexnavi" />
		</intent>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="geo" />
		</intent>
	</queries>

	<!-- GPS желателен, но приложение ставится и на устройства без него -->
	<uses-feature android:name="android.hardware.location.gps" android:required="false" />
	<uses-feature android:name="android.hardware.location.network" android:required="false" />
</manifest>
