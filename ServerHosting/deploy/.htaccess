# Корневой .htaccess для корня домена (~/domains/taxi.event72.ru/.htaccess)
# Проксирует /api/* и /admin/* в ServerHosting/ без симлинков.
Options -Indexes
AddDefaultCharset utf-8

# БЕЗОПАСНОСТЬ: закрываем .git и служебное из web-доступа
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/ServerHosting/(src|sql)(/|$)

RewriteEngine On

# Схема за прокси (nginx → Apache): редиректы mod_dir должны оставаться на
# https, иначе приложения на Android блокируют «открытый» http (connection failure)
SetEnvIf X-Forwarded-Proto https HTTPS=on

# Коллекции без слеша: /api/orders и /api/drivers — реальные каталоги, на них
# mod_dir отвечал 301 и ТЕРЯЛ POST-тело (создание заказа падало в приложении).
# Проксируем в router сами, ДО проверки -d
RewriteRule ^api/orders$ ServerHosting/api/router.php?route=orders [L,QSA]
RewriteRule ^api/drivers$ ServerHosting/api/router.php?route=drivers [L,QSA]

# Уже существующие реальные файлы отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Точное вхождение без слеша
RewriteRule ^api/?$ ServerHosting/api/index.php [L,QSA]
RewriteRule ^admin/?$ ServerHosting/admin/index.php [L,QSA]

# Явные пути
RewriteRule ^api/(.*)$ ServerHosting/api/$1 [L,QSA]
RewriteRule ^admin/(.*)$ ServerHosting/admin/$1 [L,QSA]
