# REST compatibility: ASP.NET-подобные /api/Orders/... маршруты
RewriteEngine On

# /api/orders совпадает с физическим каталогом: направляем в router ДО проверки -d,
# иначе mod_dir сделает redirect и POST может потерять JSON-тело
RewriteRule ^orders$ router.php?route=orders [QSA,L,NC,END]

# Голый /api/drivers — тоже каталог: без этого mod_dir отвечал бы 301
RewriteRule ^drivers$ router.php?route=drivers [QSA,L,NC,END]

# Существующие PHP-файлы и каталоги — без изменений
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Всё остальное — compatibility router
RewriteRule ^(.+?)/?$ router.php?route=$1 [QSA,L]

Options -Indexes
