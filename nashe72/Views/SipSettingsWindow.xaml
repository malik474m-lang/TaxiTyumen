<Window x:Class="TaxiOperator.Views.SipSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки SIP-телефонии"
        Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" ResizeMode="NoResize">
    <ScrollViewer>
        <StackPanel Margin="22">
            <TextBlock Text="SIP-телефония" FontSize="20" FontWeight="Bold" Foreground="#FFD700"/>
            <TextBlock Text="Приём звонков клиентов через гарнитуру компьютера"
                       Foreground="LightGray" FontSize="12" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <CheckBox x:Name="EnabledBox" Content="Включить телефонию"
                      Foreground="White" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Сервер АТС (домен или IP)" Foreground="LightGray" FontSize="11"/>
            <TextBox x:Name="ServerBox" Background="#2D2D3F" Foreground="White" BorderBrush="#555"
                     Padding="8,6" Margin="0,4,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Внутренний номер" Foreground="LightGray" FontSize="11"/>
                    <TextBox x:Name="UserBox" Background="#2D2D3F" Foreground="White" BorderBrush="#555"
                             Padding="8,6" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Пароль" Foreground="LightGray" FontSize="11"/>
                    <PasswordBox x:Name="PassBox" Background="#2D2D3F" Foreground="White" BorderBrush="#555"
                                 Padding="8,6" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Отображаемое имя" Foreground="LightGray" FontSize="11"/>
            <TextBox x:Name="DisplayBox" Background="#2D2D3F" Foreground="White" BorderBrush="#555"
                     Padding="8,6" Margin="0,4,0,18"/>

            <TextBlock Text="Гарнитура" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

            <TextBlock Text="Микрофон" Foreground="LightGray" FontSize="11"/>
            <ComboBox x:Name="InputBox" Background="#2D2D3F" Foreground="Black"
                      Padding="8,6" Margin="0,4,0,12"/>

            <TextBlock Text="Наушники / динамики" Foreground="LightGray" FontSize="11"/>
            <ComboBox x:Name="OutputBox" Background="#2D2D3F" Foreground="Black"
                      Padding="8,6" Margin="0,4,0,16"/>

            <CheckBox x:Name="AutoAnswerBox" Content="Автоответ на входящий звонок"
                      Foreground="White" Margin="0,0,0,8"/>
            <CheckBox x:Name="AutoFillBox" Content="Подставлять номер звонящего в новый заказ"
                      Foreground="White" Margin="0,0,0,18"/>

            <TextBlock x:Name="HintText" Foreground="#FF9800" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Сохранить и подключиться" Click="OnSave"
                        Background="#FFD700" Foreground="#1E1E2E" FontWeight="Bold"
                        BorderThickness="0" Padding="12,10" Cursor="Hand"/>
                <Button Grid.Column="2" Content="Отмена" Click="OnCancel"
                        Background="#333" Foreground="White"
                        BorderThickness="0" Padding="12,10" Cursor="Hand"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
