<Window x:Class="TaxiOperator.Views.DriverSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбрать водителя" Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите водителя для назначения:"
                   Foreground="White" FontSize="14" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" x:Name="DriversList"
                 Background="#252536" Foreground="White"
                 BorderBrush="#555" FontSize="13"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content=" Назначить"
                    Click="OnConfirmClick"
                    Background="#4CAF50" Foreground="White"
                    BorderThickness="0" Padding="15,8"
                    Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Отмена"
                    Click="OnCancelClick"
                    Background="#555" Foreground="White"
                    BorderThickness="0" Padding="15,8"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>