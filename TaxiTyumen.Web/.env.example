DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# секрет для подписи сессионных HMAC-токенов (AUTH_SECRET) — в проде обязательно свой
# AUTH_SECRET=change-me-to-long-random-string

# (опционально) ключ sms.ru — без него SMS-вход работает в демо-режиме
# SMS_API_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxxx

# Яндекс Карты JavaScript API 2.1 + HTTP Геокодер
# Ограничьте ключ доменом в Кабинете разработчика Яндекса
YANDEX_MAPS_API_KEY=
